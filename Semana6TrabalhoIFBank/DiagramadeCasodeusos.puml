@startuml
left to right direction
actor Cliente
actor "Sistema BACEN" as BACEN
rectangle IFBank {
    usecase "Autenticar Usuário" as UC1
    usecase "Consultar Saldo" as UC2
    usecase "Cadastrar Chave Pix" as UC3
    usecase "Realizar Pix" as UC4
}
Cliente --> UC2
Cliente --> UC3
Cliente --> UC4
UC2 ..> UC1 : <<include>>
UC3 ..> UC1 : <<include>>
UC4 ..> UC1 : <<include>>
BACEN --> UC4
@enduml